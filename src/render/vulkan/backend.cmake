# src/render/vulkan/backend.cmake -- the Vulkan renderer backend (BANISHED_RENDER_BACKEND=vulkan;
# Windows as the development bed, Linux, Android). docs/vulkan/PLAN.md.
#
# Included by the top-level CMakeLists.txt from src/render/${BANISHED_RENDER_BACKEND}/backend.cmake,
# before the targets exist. The contract (src/render/common/README.md):
#   RENDER_SRCS              the backend's own sources
#   RENDER_BACKEND_INCLUDES  the backend's include directories
#   RENDER_BACKEND_READY     ON when OpenBA can be configured with this backend on this host
# RENDER_BACKEND_LINK_LIBRARIES is dxbc_spv only (below): nothing links against the Vulkan loader.
# SDL opens it when the window is created and the backend resolves every entry point through
# vkGetInstanceProcAddr (src/render/vulkan/vk_api.h). Two more outputs for the unit build:
# RENDER_BACKEND_UNIT_SRCS / RENDER_BACKEND_UNIT_LIBS (the shader converter and its library). The headers are the pinned submodule
# third_party/Vulkan-Headers (Apache-2.0 / MIT; THIRD_PARTY_NOTICES.md), used with
# VK_NO_PROTOTYPES, as -isystem: they are Khronos's, not ours.

set(BANISHED_VULKAN_HEADERS ${CMAKE_SOURCE_DIR}/third_party/Vulkan-Headers/include)
if(NOT EXISTS ${BANISHED_VULKAN_HEADERS}/vulkan/vulkan.h)
  set(RENDER_SRCS)
  set(RENDER_BACKEND_INCLUDES)
  set(RENDER_BACKEND_READY OFF)
  message(STATUS "OpenBA not configured: BANISHED_RENDER_BACKEND=vulkan needs the third_party/Vulkan-Headers submodule (git submodule update --init third_party/Vulkan-Headers)")
  return()
endif()

# VMA (docs/vulkan/PLAN.md §4.4): the pinned header-only submodule third_party/VulkanMemoryAllocator
# (GPUOpen, MIT; THIRD_PARTY_NOTICES.md), -isystem like the Vulkan headers; its implementation is
# compiled once, in vma_impl.cpp (with -w: upstream's warnings are not ours), configured by vk_mem.h.
set(BANISHED_VMA_INCLUDE ${CMAKE_SOURCE_DIR}/third_party/VulkanMemoryAllocator/include)
if(NOT EXISTS ${BANISHED_VMA_INCLUDE}/vk_mem_alloc.h)
  set(RENDER_SRCS)
  set(RENDER_BACKEND_INCLUDES)
  set(RENDER_BACKEND_READY OFF)
  message(STATUS "OpenBA not configured: BANISHED_RENDER_BACKEND=vulkan needs the third_party/VulkanMemoryAllocator submodule (git submodule update --init third_party/VulkanMemoryAllocator)")
  return()
endif()

file(GLOB_RECURSE RENDER_SRCS CONFIGURE_DEPENDS ${CMAKE_SOURCE_DIR}/src/render/vulkan/*.cpp)
set(RENDER_BACKEND_INCLUDES ${CMAKE_SOURCE_DIR}/src/render/vulkan)
set(RENDER_BACKEND_READY ON)
set_source_files_properties(${RENDER_SRCS} PROPERTIES
                            COMPILE_OPTIONS "-isystem;${BANISHED_VULKAN_HEADERS};-isystem;${BANISHED_VMA_INCLUDE}")
set_property(SOURCE ${CMAKE_SOURCE_DIR}/src/render/vulkan/vma_impl.cpp APPEND PROPERTY COMPILE_OPTIONS -w)

# ---- dxbc-spirv: the DXBC -> SPIR-V compiler (docs/vulkan/PLAN.md §4.2) ---------------------
# The pinned submodule third_party/dxbc-spirv (doitsujin, MIT; THIRD_PARTY_NOTICES.md), built here
# as a static library from its own sources: upstream builds with Meson, which is not part of this
# toolchain, so the source list is globbed in the shape of its meson.build (dxbc/ = the SM4/SM5
# front end, ir/ + ir/passes/ = the IR and its passes, spirv/ = the SPIR-V back end, util/; sm3/,
# tests/ and tools/ are left out). Upstream's warnings are not ours to fix: -w, as for ASSAO and
# Dear ImGui. Always -O2: the conversion runs on the loader thread at the first boot.
#
# SPIR-V headers. dxbc-spirv includes them through its own nested submodule
# ("../submodules/spirv_headers/include/spirv/unified1/spirv.hpp"), which a non-recursive checkout
# (CI's `submodules: true`) leaves empty. The headers are the top-level submodule
# third_party/SPIRV-Headers instead, pinned at the commit dxbc-spirv pins, and two forwarding
# headers written into the build directory make that relative include resolve there: the include
# directory below is <build>/dxbc_spv_shim/include, so "../submodules/..." lands in
# <build>/dxbc_spv_shim/submodules/... when the nested copy is absent.
set(BANISHED_DXBC_SPIRV_DIR ${CMAKE_SOURCE_DIR}/third_party/dxbc-spirv)
set(BANISHED_SPIRV_HEADERS_DIR ${CMAKE_SOURCE_DIR}/third_party/SPIRV-Headers/include)
if(NOT EXISTS ${BANISHED_DXBC_SPIRV_DIR}/dxbc/dxbc_api.h OR NOT EXISTS ${BANISHED_SPIRV_HEADERS_DIR}/spirv/unified1/spirv.hpp)
  set(RENDER_SRCS)
  set(RENDER_BACKEND_INCLUDES)
  set(RENDER_BACKEND_READY OFF)
  message(STATUS "OpenBA not configured: BANISHED_RENDER_BACKEND=vulkan needs the third_party/dxbc-spirv and third_party/SPIRV-Headers submodules (git submodule update --init third_party/dxbc-spirv third_party/SPIRV-Headers)")
  return()
endif()
set(BANISHED_DXBC_SPV_SHIM ${CMAKE_BINARY_DIR}/dxbc_spv_shim)
foreach(_spv_header spirv.hpp GLSL.std.450.h)
  file(WRITE ${BANISHED_DXBC_SPV_SHIM}/submodules/spirv_headers/include/spirv/unified1/${_spv_header}.tmp
       "// Generated by src/render/vulkan/backend.cmake: forwards to the pinned SPIRV-Headers submodule.\n#include \"${BANISHED_SPIRV_HEADERS_DIR}/spirv/unified1/${_spv_header}\"\n")
  configure_file(${BANISHED_DXBC_SPV_SHIM}/submodules/spirv_headers/include/spirv/unified1/${_spv_header}.tmp
                 ${BANISHED_DXBC_SPV_SHIM}/submodules/spirv_headers/include/spirv/unified1/${_spv_header} COPYONLY)
endforeach()
file(MAKE_DIRECTORY ${BANISHED_DXBC_SPV_SHIM}/include)
file(GLOB BANISHED_DXBC_SPV_SRCS CONFIGURE_DEPENDS
     ${BANISHED_DXBC_SPIRV_DIR}/dxbc/*.cpp
     ${BANISHED_DXBC_SPIRV_DIR}/ir/*.cpp
     ${BANISHED_DXBC_SPIRV_DIR}/ir/passes/*.cpp
     ${BANISHED_DXBC_SPIRV_DIR}/spirv/*.cpp
     ${BANISHED_DXBC_SPIRV_DIR}/util/*.cpp)
add_library(dxbc_spv STATIC EXCLUDE_FROM_ALL ${BANISHED_DXBC_SPV_SRCS})
target_compile_options(dxbc_spv PRIVATE -w -O2)
# Upstream's asserts stay on in the debug flavour (the check tool and the dev bed run it) and are
# compiled out elsewhere, as in a DXVK release build.
if(NOT BANISHED_FLAVOUR STREQUAL "debug")
  target_compile_definitions(dxbc_spv PRIVATE NDEBUG)
endif()
# The two front ends' switches, PUBLIC: the headers test them too.
target_compile_definitions(dxbc_spv PUBLIC DXBC_SPV_ENABLE_SM5 DXBC_SPV_ENABLE_SPIRV)
target_include_directories(dxbc_spv SYSTEM PUBLIC ${BANISHED_DXBC_SPIRV_DIR} ${BANISHED_DXBC_SPV_SHIM}/include)
# The dxbc-spirv commit is part of the SPIR-V cache key (shader_convert.cpp): read from the
# submodule's checkout at configure time, so a bumped submodule misses every old cache entry.
execute_process(COMMAND git -C ${BANISHED_DXBC_SPIRV_DIR} rev-parse HEAD
                OUTPUT_VARIABLE BANISHED_DXBC_SPIRV_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE
                RESULT_VARIABLE _dxbc_spv_rev ERROR_QUIET)
if(NOT _dxbc_spv_rev EQUAL 0 OR BANISHED_DXBC_SPIRV_COMMIT STREQUAL "")
  set(BANISHED_DXBC_SPIRV_COMMIT unknown)
endif()
set(BANISHED_VULKAN_SHADER_DEFS "BANISHED_DXBC_SPIRV_COMMIT=\"${BANISHED_DXBC_SPIRV_COMMIT}\"")
message(STATUS "OpenBA vulkan: dxbc-spirv ${BANISHED_DXBC_SPIRV_COMMIT}")

# OpenBA and unit link the library WITHOUT its usage requirements ($<LINK_ONLY:>): only
# shader_convert.cpp includes its headers, so only that file gets its switches and include
# directories, and every other compile line stays the same as the dx11 configure's (ccache).
set(RENDER_BACKEND_LINK_LIBRARIES $<LINK_ONLY:dxbc_spv>)
set_property(SOURCE ${CMAKE_SOURCE_DIR}/src/render/vulkan/shader_convert.cpp APPEND PROPERTY
             COMPILE_DEFINITIONS ${BANISHED_VULKAN_SHADER_DEFS} DXBC_SPV_ENABLE_SM5 DXBC_SPV_ENABLE_SPIRV)
set_property(SOURCE ${CMAKE_SOURCE_DIR}/src/render/vulkan/shader_convert.cpp APPEND PROPERTY
             COMPILE_OPTIONS -isystem ${BANISHED_DXBC_SPIRV_DIR} -isystem ${BANISHED_DXBC_SPV_SHIM}/include)
# What the unit build adds when this backend is configured (tests/unit/vulkan_shader_convert_test.cpp):
# the converter and its cache entry point, which need neither a Vulkan header nor a device (the
# derived cache and its hash are in the unit build already), and the library.
set(RENDER_BACKEND_UNIT_SRCS ${CMAKE_SOURCE_DIR}/src/render/vulkan/shader_convert.cpp
                             ${CMAKE_SOURCE_DIR}/src/render/vulkan/spirv_combine.cpp
                             ${CMAKE_SOURCE_DIR}/src/render/vulkan/spirv_legalize.cpp
                             ${CMAKE_SOURCE_DIR}/src/render/vulkan/shader_cache.cpp)
set(RENDER_BACKEND_UNIT_LIBS $<LINK_ONLY:dxbc_spv>)

# ---- vulkan-shader-check (tools/vulkan/shader_check.cpp): the metal-shader-check twin -----------
# Converts every vertex and pixel program of the user's install through the same converter and
# validates each module with spirv-val when one is on PATH. Not part of the default build:
#   cmake --build build/cmake-debug-vulkan -t vulkan-shader-check
add_executable(vulkan-shader-check EXCLUDE_FROM_ALL
               ${CMAKE_SOURCE_DIR}/tools/vulkan/shader_check.cpp
               ${CMAKE_SOURCE_DIR}/src/render/vulkan/shader_convert.cpp
               ${CMAKE_SOURCE_DIR}/src/render/vulkan/spirv_combine.cpp
               ${CMAKE_SOURCE_DIR}/src/render/vulkan/spirv_legalize.cpp
               ${CMAKE_SOURCE_DIR}/src/ext/derived_cache/hash64.cpp)
set_target_properties(vulkan-shader-check PROPERTIES RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR})
target_include_directories(vulkan-shader-check PRIVATE ${CMAKE_SOURCE_DIR}/src/render/vulkan ${CMAKE_SOURCE_DIR}/src
                           ${CMAKE_SOURCE_DIR}/src/platform/common)
target_compile_options(vulkan-shader-check PRIVATE -g -O1 -Wall -Wextra)
target_link_libraries(vulkan-shader-check PRIVATE dxbc_spv)
if(WIN32)
  target_link_options(vulkan-shader-check PRIVATE -static -static-libgcc -static-libstdc++)
endif()
