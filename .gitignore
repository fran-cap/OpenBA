# Python
__pycache__/
*.py[cod]
.venv/

# GhidraMCP tools (downloaded binaries, not source)
tools/ghidra_mcp/.venv/
tools/ghidra_mcp/GhidraMCP-3.0.0.zip
tools/ghidra_mcp/bridge_mcp_ghidra.py

# RenderDoc MCP (cloned source + built binaries — see notes for build steps)
tools/renderdoc_mcp/
tools/renderdoc_build/

# Ghidra project files
*.gpr
*.rep/

# IDE
.vscode/
.idea/

# Build artifacts
patches/build/
build/

# OS
Thumbs.db
.DS_Store

#toolkit files
/ToolKit/
tools/ghidra_mcp/ghidbackup.zip
# a regenerated Ghidra hash index lands at the root (bridge_mcp_ghidra.py writes relative to its cwd)
/function_hash_index.json
# Ghidra hash indexes: derived from the retail binaries, regenerate locally, see tools/ghidra_mcp/hash_index/README.md
tools/ghidra_mcp/hash_index/*.json
docs/history/runtime_port/runtime_hash_index.json

#misc
*.lock
*.log

# Screenshots / capture artifacts (game screenshots are not committed: "no game content")
*.png
!images/**
# the extension resources' sprite sources (tools/ext_resources.sh compiles them; build/ext_resources/ is ignored with build/)
!src/ext/ui/**/*.png
# ext.sharp_ui's magnified-sheet art (our own: tools/sharp_sprites/bake.py + chrome.py)
!src/ext/sharp_ui/art/**/*.png
!android/app/src/main/res/mipmap-*/ic_launcher.png
standalone/*.png

# Standalone run-capture diagnostics (transient crash/trace dumps, not source)
notes/wp_runs/*.txt
notes/wp_runs/*.err
Banished_RE.lock

# RenderDoc captures (large binary .rdc artifacts)
captures/
*psd

# stress/perf run outputs (keep baselines, not results)
perf/results/
build/perf/
build/og/

# libm bit-exactness probe binaries (source is checked in; rebuild with the
# command in the header of tools/libm_probe/sweep.cpp)
tools/libm_probe/*.exe
tools/libm_probe/full_sweep.txt

# Per-lane run-log snapshots taken by tools/game_dir_lock.sh --snapshot.
# Evidence for a lane report, not source; the lane doc quotes what matters.
lane_*_logs/
tools/endsprites_probe/sweep.exe
tools/gfxmat24_probe/probe.exe

# resave gate: 21 MB raw images and per-run logs stay local; the golden md5 is committed
docs/runtime_port/resave_gate/**/*.bin
docs/runtime_port/resave_gate/run*/
build/unit/

# Per-step run logs and B11 object bases (2+ GB; never committed)
docs/history/endgame_b/b*_session/runs/
docs/runtime_port/phase_d/runs/
docs/history/notes/wp_runs/*.err
*.lock~

# macOS port: local dependency builds and outputs
/dist/
/run/
third_party/dxmt_src/
third_party/airconv_build/build/
third_party/llvm15_arm64/source/
third_party/llvm15_arm64/build/
